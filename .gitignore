# ==============================================================================
# .gitignore for Packera dubia Morphometrics & Species Delimitation Pipeline
# ==============================================================================
# This configuration ignores temporary development files, environment artifacts,
# bulky datasets (raw herbarium images, segmentations, raster layers, YOLO splits),
# visual QC image dumps, and model checkpoint weights while keeping code, configs,
# manifests, and pipeline documentation tracked.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Cloud Storage Artifacts (Windows, macOS, Google Drive)
# ------------------------------------------------------------------------------
# Windows system and thumbnail caching files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump

# Windows Desktop folder configuration (frequently synced by Google Drive)
[Dd]esktop.ini
desktop.ini

# macOS metadata and directory icon files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Google Drive sync conflict, temp lock files, and web shortcut pointers
*.tmp
~$*
.gdrive*
*.gdoc
*.gsheet
*.gslides
*.gdraw
*.gtable
*.gform
*.gshortcut
* (1).*
* (2).*
* (3).*
* (4).*
* (5).*

# ------------------------------------------------------------------------------
# 2. Python Environment & Bytecode
# ------------------------------------------------------------------------------
# Python bytecode compilation artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution and packaging builds
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
.venv*/
.venv_LM2/
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints and autosaves
.ipynb_checkpoints/
*-checkpoint.ipynb

# Python testing, typing, and linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# ------------------------------------------------------------------------------
# 3. R Environment & Project Artifacts
# ------------------------------------------------------------------------------
# R history and interactive session workspace files
.Rhistory
.RData
.RDataTmp
.Ruserdata

# RStudio project configuration and session data
.Rproj.user/

# ------------------------------------------------------------------------------
# 4. Large Dataset Directories & Raw Herbarium Files
# ------------------------------------------------------------------------------
# Ignore all downloaded raw voucher images, segmented masks, and cropped patches
# (Preserve directory structure using .gitkeep)
data/raw_vouchers/*
data/raw_vouchers/**
!data/raw_vouchers/.gitkeep
data/raw_vouchers_*
data/raw_vouchers_*/**

data/raw_annotations/*
data/raw_annotations/**
!data/raw_annotations/.gitkeep
data/raw_annotations_*
data/raw_annotations_*/**

data/raw_vouchers_quarantine/*
data/raw_vouchers_quarantine/**
!data/raw_vouchers_quarantine/.gitkeep

data/cropped_patches/*
data/cropped_patches/**
!data/cropped_patches/.gitkeep

data/masks/*
data/masks/**
!data/masks/.gitkeep

data/environmental/*
data/environmental/**
!data/environmental/.gitkeep

# Annotation and label files inside data directories
data/**/*.txt
data/**/*.json
!data/**/manifest*.json
!data/**/config*.json
!data/**/dataset_config.json
data/**/*.geojson
data/**/*.xml

# YOLO dataset split images and annotations (regenerated via pipeline scripts)
data/yolo_dataset/*
data/yolo_dataset/**
!data/yolo_dataset/images/.gitkeep
!data/yolo_dataset/labels/.gitkeep

# Tabular datasets, CSVs, and spreadsheets across all folders
*.csv
*.tsv
*.xlsx
*.xls
*.ods
data/tables/*
!data/tables/.gitkeep

# Native DPI patch tiler and sliced SAHI datasets
data/tiled_dataset/
data/tiled_dataset/**
data/dry_run/
data/dry_run/**

# Ignore all outputs generated by the pipeline
outputs/*
outputs/**
!outputs/.gitkeep
!outputs/reports/
outputs/reports/*
!outputs/reports/.gitkeep
!outputs/reports/dataset_build_summary.json

# Large imagery, raster dumps, and image files across all subfolders
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.gif
*.ico
*.svg
*.tif
*.tiff
*.geotiff
*.jp2
*.sid
*.nc
*.hdf5
*.h5

# Bulky columnar / database serialized formats
*.parquet
*.feather
*.arrow
*.zarr
*.sqlite3
*.db

# Scratch and debug directories
scratch/

# ------------------------------------------------------------------------------
# Archive, Backup, Snapshot & Quarantine Directories
# ------------------------------------------------------------------------------
# Historical, legacy, and decommissioned scripts / data
*_archive/
*_archive/**
*archive/
*archive/**
_archive/
_archive/**
archive/
archive/**
**/_archive/
**/_archive/**
**/archive/
**/archive/**
data/_archive/
scripts/_archive/
outputs/_archive/

# Timestamped and ad-hoc backup directories
*_backup/
*_backup/**
*_backup_*/
*_backup_*/**
*backup*/
*backup*/**
_backup/
_backup/**
backup/
backup/**
**/*_backup/
**/*_backup/**
**/*_backup_*/
**/*_backup_*/**
**/backup/
**/backup/**
**/*backup*/
**/*backup*/**
data/*backup*/
data/*_backup_*/
data/*_backup/

# Substandard vouchers and quarantine directories
*_quarantine/
*_quarantine/**
*_quarantine_*/
*_quarantine_*/**
*quarantine*/
*quarantine*/**
**/*_quarantine/
**/*_quarantine/**
**/*_quarantine_*/
**/*_quarantine_*/**
**/*quarantine*/
**/*quarantine*/**

# Snapshots and checkpoint dumps
*_snapshot/
*_snapshot/**
*_snapshot_*/
*_snapshot_*/**
*snapshot*/
*snapshot*/**
**/*snapshot*/
**/*snapshot*/**

# ------------------------------------------------------------------------------
# 5. Machine Learning Models, Weights & Experiment Tracking
# ------------------------------------------------------------------------------
# Neural network checkpoints and serialized model weights across all folders
*.pt
*.pth
*.onnx
*.engine
*.pkl
*.joblib
*.bin
*.safetensors

# Models directory contents (keep directory structure and configs)
models/*
!models/.gitkeep
!models/*.yaml
!models/*.json

# Experiment tracking and training logs (e.g., Ultralytics YOLO runs, WandB)
runs/
wandb/
checkpoints/

# ------------------------------------------------------------------------------
# 6. High-Resolution Visual QC Outputs & Figures
# ------------------------------------------------------------------------------
# High-volume visual QC image outputs generated during segmentation / extraction
outputs/dataset_qc/*
!outputs/dataset_qc/.gitkeep

outputs/figures/qc_leaf_extractions/*
!outputs/figures/qc_leaf_extractions/.gitkeep

# ------------------------------------------------------------------------------
# 7. Sensitive Information, Credentials & API Keys
# ------------------------------------------------------------------------------
# Environment configuration containing secrets or GBIF/iDigBio/API tokens
.env*
!.env.example
*.pem
*.key
credentials.json
token.json
secrets.yaml

# ------------------------------------------------------------------------------
# 8. Logs and Temporary Pipeline Artifacts
# ------------------------------------------------------------------------------
*.log
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 9. LeafMachine2 Model, Cloned Repository & Project Workspace
# ------------------------------------------------------------------------------
# LeafMachine2 cloned upstream repository, weights, and component detector models
LeafMachine2/

# LeafMachine2 working project data and outputs
LM2_Project/


